# ============================================================
# PattaPe — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit secrets to version control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env and fill in your actual values.
#
# Three layers share this file in the integration branch:
#   1. Frontend (Vite) — variables prefixed with VITE_
#   2. Backend (FastAPI) — loaded by python-dotenv from backend/.env
#   3. ML (gemini_explainer.py) — reads GEMINI_API_KEY

# ----------------------------------------------------------
# Frontend (Vite) Variables
# ----------------------------------------------------------
# These are embedded into the browser bundle by Vite.
# NEVER put secrets (API keys) in VITE_ variables.

# URL of the running FastAPI backend (default: local dev server)
VITE_API_BASE_URL=http://localhost:8000

# Set to 'true' to bypass the backend and use built-in mock responses.
# Set to 'false' (or leave unset) to use the real FastAPI backend.
VITE_USE_MOCK=false

# ----------------------------------------------------------
# Backend (FastAPI) Variables
# ----------------------------------------------------------
# These are read from backend/.env by python-dotenv.

# Set to 'true' for mock model (no ML checkpoint required).
# Set to 'false' once ml/checkpoints/best.pt is available.
MOCK_MODEL=true

# Timeout for real ML inference (seconds)
MODEL_TIMEOUT_SECONDS=5.0

# Artificial latency when MOCK_MODEL=true (seconds, 0.0 = instant)
MOCK_LATENCY_SECONDS=0.0

HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------
# Gemini API Key (ML second opinion)
# ----------------------------------------------------------
# Used by ml/gemini_explainer.py for Gemini 2.5 Flash-Lite.
# Loaded server-side ONLY — never expose to frontend.
# Get your key from: https://aistudio.google.com/apikey
#
GEMINI_API_KEY=your_gemini_api_key_here

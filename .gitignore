# =====================================================================
# PattaPe .gitignore
# =====================================================================

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
*.dist-info/

# -------------------------
# ML - Datasets (large, not versioned)
# -------------------------
ml/raw_data/
ml/data/

# -------------------------
# ML - Generated outputs (reproducible on run)
# -------------------------
ml/checkpoints/
ml/runs/
ml/outputs/
ml/heatmaps/
backend/static/heatmaps/

# -------------------------
# Environment / secrets
# -------------------------
.env
backend/.env
!.env.example
!backend/.env.example

# -------------------------
# Editor directories
# -------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------------------------
# OS artifacts
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Pytest / test cache
# -------------------------
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# -------------------------
# Misc
# -------------------------
*.bak
*.tmp

# -------------------------
# Internal Planning & Context Docs
# -------------------------
CONTEXT_FOR_CHATGPT.md
context_for_chatgpt*
BACKEND_INTEGRATION.md
backend_integration*
SIH26131_battle_plan.md
*battle_plan.md
